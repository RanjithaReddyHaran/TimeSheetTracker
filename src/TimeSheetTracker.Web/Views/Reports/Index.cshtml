@model IReadOnlyList<ReportRow>
@{
    ViewData["Title"] = "Reports";
}
<h1 class="h2 mb-1">Approved hours report</h1>
<p class="text-muted">Hours grouped by employee and project.</p>
<form method="get" class="row g-3 mb-4">
 <div class="col-md-3"><label class="form-label">From</label><input class="form-control" type="date" name="from" value="@ViewBag.From.ToString("yyyy-MM-dd")" /></div>
 <div class="col-md-3"><label class="form-label">To</label><input class="form-control" type="date" name="to" value="@ViewBag.To.ToString("yyyy-MM-dd")" /></div>
 <div class="col-md-2 align-self-end"><button class="btn btn-primary">Run report</button></div>
</form>
<div asp-validation-summary="All" class="text-danger"></div>
<div class="card"><div class="table-responsive"><table class="table mb-0">
 <thead><tr><th>Employee</th><th>Project</th><th class="text-end">Approved hours</th></tr></thead>
 <tbody>
 @foreach (var row in Model) { <tr><td>@row.EmployeeName</td><td>@row.ProjectName</td><td class="text-end">@row.TotalHours.ToString("0.00")</td></tr> }
 @if (Model.Count == 0) { <tr><td colspan="3" class="text-center text-muted py-4">No approved hours in this date range.</td></tr> }
 </tbody>
 <tfoot><tr class="fw-bold"><td colspan="2">Total</td><td class="text-end">@Model.Sum(x => x.TotalHours).ToString("0.00")</td></tr></tfoot>
</table></div></div>
